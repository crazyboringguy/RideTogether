# API runtime (required only for non-default configuration)
NODE_ENV=development
PORT=3000

# Data services (not required by the Phase 1 health endpoint)
DATABASE_URL=
REDIS_URL=

# Firebase (planned for a later authentication phase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Maps and notifications (planned for later phases)
MAPS_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
