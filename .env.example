# API runtime (required only for non-default configuration)
NODE_ENV=development
PORT=3000

# PostgreSQL is required for authentication endpoints; /health remains database-independent.
DATABASE_URL=

# Authentication: use a unique random value of at least 32 characters in each environment.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=15

# Planned later-phase data service
REDIS_URL=

# Firebase (planned for a later phase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Maps and notifications (planned for later phases)
MAPS_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
