{
  "name": "ridetogether",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:dev": "pnpm --filter @ridetogether/api dev",
    "api:build": "pnpm --filter @ridetogether/api build",
    "api:test": "pnpm --filter @ridetogether/api test",
    "web:dev": "pnpm --filter @ridetogether/family-web dev",
    "web:build": "pnpm --filter @ridetogether/family-web build",
    "web:test": "pnpm --filter @ridetogether/family-web test",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
